{"id": "CBTRN02C-G1", "program": "CBTRN02C", "paragraph": "1500-A-LOOKUP-XREF", "kind": "validation", "summary": "A daily transaction is rejected when its card number is not in the card cross-reference file.", "condition": "READ XREF-FILE by DALYTRAN-CARD-NUM returns INVALID KEY", "outcome": "WS-VALIDATION-FAIL-REASON = 100, 'INVALID CARD NUMBER FOUND'", "fields": ["DALYTRAN-CARD-NUM", "WS-VALIDATION-FAIL-REASON"], "citations": [{"program": "CBTRN02C", "start_line": 382, "end_line": 387}]}
{"id": "CBTRN02C-G2", "program": "CBTRN02C", "paragraph": "1500-B-LOOKUP-ACCT", "kind": "validation", "summary": "A transaction is rejected when the account linked to the card does not exist.", "condition": "READ ACCOUNT-FILE by XREF-ACCT-ID returns INVALID KEY", "outcome": "WS-VALIDATION-FAIL-REASON = 101, 'ACCOUNT RECORD NOT FOUND'", "fields": ["XREF-ACCT-ID", "WS-VALIDATION-FAIL-REASON"], "citations": [{"program": "CBTRN02C", "start_line": 394, "end_line": 399}]}
{"id": "CBTRN02C-G3", "program": "CBTRN02C", "paragraph": "1500-B-LOOKUP-ACCT", "kind": "validation", "summary": "A transaction is rejected when it would push the cycle balance over the account's credit limit.", "condition": "ACCT-CURR-CYC-CREDIT - ACCT-CURR-CYC-DEBIT + DALYTRAN-AMT is greater than ACCT-CREDIT-LIMIT", "outcome": "WS-VALIDATION-FAIL-REASON = 102, 'OVERLIMIT TRANSACTION'", "fields": ["ACCT-CREDIT-LIMIT", "WS-TEMP-BAL", "DALYTRAN-AMT"], "citations": [{"program": "CBTRN02C", "start_line": 403, "end_line": 413}]}
{"id": "CBTRN02C-G4", "program": "CBTRN02C", "paragraph": "1500-B-LOOKUP-ACCT", "kind": "validation", "summary": "A transaction is rejected when it was made after the account's expiration date; this check runs after the limit check and overwrites its reason code.", "condition": "ACCT-EXPIRAION-DATE is earlier than the date part of DALYTRAN-ORIG-TS", "outcome": "WS-VALIDATION-FAIL-REASON = 103, 'TRANSACTION RECEIVED AFTER ACCT EXPIRATION'", "fields": ["ACCT-EXPIRAION-DATE", "DALYTRAN-ORIG-TS"], "citations": [{"program": "CBTRN02C", "start_line": 414, "end_line": 420}]}
{"id": "CBTRN02C-G5", "program": "CBTRN02C", "paragraph": "MAIN", "kind": "routing", "summary": "Valid transactions are posted; any transaction with a failure reason goes to the daily reject file instead.", "condition": "WS-VALIDATION-FAIL-REASON = 0 after 1500-VALIDATE-TRAN", "outcome": "PERFORM 2000-POST-TRANSACTION, otherwise PERFORM 2500-WRITE-REJECT-REC and count the reject", "fields": ["WS-VALIDATION-FAIL-REASON", "WS-REJECT-COUNT"], "citations": [{"program": "CBTRN02C", "start_line": 210, "end_line": 216}]}
{"id": "CBTRN02C-G6", "program": "CBTRN02C", "paragraph": "MAIN", "kind": "error-handling", "summary": "The batch job ends with return code 4 when at least one transaction was rejected.", "condition": "WS-REJECT-COUNT > 0 at end of run", "outcome": "RETURN-CODE = 4", "fields": ["WS-REJECT-COUNT", "RETURN-CODE"], "citations": [{"program": "CBTRN02C", "start_line": 229, "end_line": 231}]}
{"id": "COSGN00C-G1", "program": "COSGN00C", "paragraph": "MAIN-PARA", "kind": "routing", "summary": "Pressing PF3 on the sign-on screen ends the session with a thank-you message.", "condition": "EIBAID = DFHPF3", "outcome": "CCDA-MSG-THANK-YOU sent as plain text", "fields": ["EIBAID", "CCDA-MSG-THANK-YOU"], "citations": [{"program": "COSGN00C", "start_line": 88, "end_line": 90}]}
{"id": "COSGN00C-G2", "program": "COSGN00C", "paragraph": "MAIN-PARA", "kind": "validation", "summary": "Any key other than Enter or PF3 is rejected with an invalid-key message.", "condition": "EIBAID is not DFHENTER or DFHPF3", "outcome": "WS-ERR-FLG = 'Y', CCDA-MSG-INVALID-KEY", "fields": ["EIBAID", "CCDA-MSG-INVALID-KEY"], "citations": [{"program": "COSGN00C", "start_line": 91, "end_line": 94}]}
{"id": "COSGN00C-G3", "program": "COSGN00C", "paragraph": "PROCESS-ENTER-KEY", "kind": "validation", "summary": "User ID is required.", "condition": "USERIDI is spaces or low-values", "outcome": "'Please enter User ID ...'", "fields": ["USERIDI"], "citations": [{"program": "COSGN00C", "start_line": 118, "end_line": 122}]}
{"id": "COSGN00C-G4", "program": "COSGN00C", "paragraph": "PROCESS-ENTER-KEY", "kind": "validation", "summary": "Password is required.", "condition": "PASSWDI is spaces or low-values", "outcome": "'Please enter Password ...'", "fields": ["PASSWDI"], "citations": [{"program": "COSGN00C", "start_line": 123, "end_line": 127}]}
{"id": "COSGN00C-G5", "program": "COSGN00C", "paragraph": "PROCESS-ENTER-KEY", "kind": "other", "summary": "User ID and password are converted to upper case before the check, so sign-on is case-insensitive.", "condition": "always, before reading the security file", "outcome": "FUNCTION UPPER-CASE into WS-USER-ID and WS-USER-PWD", "fields": ["WS-USER-ID", "WS-USER-PWD"], "citations": [{"program": "COSGN00C", "start_line": 132, "end_line": 136}]}
{"id": "COSGN00C-G6", "program": "COSGN00C", "paragraph": "READ-USER-SEC-FILE", "kind": "routing", "summary": "After a correct password, admins go to the admin menu and other users to the main menu.", "condition": "SEC-USR-PWD = WS-USER-PWD; CDEMO-USRTYP-ADMIN", "outcome": "XCTL to 'COADM01C' for admin, 'COMEN01C' otherwise", "fields": ["SEC-USR-PWD", "CDEMO-USRTYP-ADMIN"], "citations": [{"program": "COSGN00C", "start_line": 223, "end_line": 240}]}
{"id": "COSGN00C-G7", "program": "COSGN00C", "paragraph": "READ-USER-SEC-FILE", "kind": "authorization", "summary": "A wrong password keeps the user on the sign-on screen.", "condition": "user found but SEC-USR-PWD differs from WS-USER-PWD", "outcome": "'Wrong Password. Try again ...'", "fields": ["SEC-USR-PWD", "WS-USER-PWD"], "citations": [{"program": "COSGN00C", "start_line": 241, "end_line": 245}]}
{"id": "COSGN00C-G8", "program": "COSGN00C", "paragraph": "READ-USER-SEC-FILE", "kind": "authorization", "summary": "An unknown user ID is rejected.", "condition": "WS-RESP-CD = 13 (record not found)", "outcome": "'User not found. Try again ...'", "fields": ["WS-RESP-CD"], "citations": [{"program": "COSGN00C", "start_line": 247, "end_line": 251}]}
{"id": "COSGN00C-G9", "program": "COSGN00C", "paragraph": "READ-USER-SEC-FILE", "kind": "error-handling", "summary": "Any other error reading the security file blocks sign-on.", "condition": "WS-RESP-CD is not 0 or 13", "outcome": "'Unable to verify the User ...'", "fields": ["WS-RESP-CD"], "citations": [{"program": "COSGN00C", "start_line": 252, "end_line": 256}]}
{"id": "COTRN02C-G1", "program": "COTRN02C", "paragraph": "MAIN-PARA", "kind": "routing", "summary": "Without a session (no COMMAREA) the user is sent back to sign-on.", "condition": "EIBCALEN = 0", "outcome": "CDEMO-TO-PROGRAM = 'COSGN00C'", "fields": ["EIBCALEN", "CDEMO-TO-PROGRAM"], "citations": [{"program": "COTRN02C", "start_line": 115, "end_line": 117}]}
{"id": "COTRN02C-G2", "program": "COTRN02C", "paragraph": "MAIN-PARA", "kind": "routing", "summary": "PF3 returns to the calling screen, or the main menu when there is no caller.", "condition": "EIBAID = DFHPF3", "outcome": "CDEMO-TO-PROGRAM = CDEMO-FROM-PROGRAM, else 'COMEN01C'", "fields": ["CDEMO-FROM-PROGRAM", "CDEMO-TO-PROGRAM"], "citations": [{"program": "COTRN02C", "start_line": 136, "end_line": 143}]}
{"id": "COTRN02C-G3", "program": "COTRN02C", "paragraph": "MAIN-PARA", "kind": "other", "summary": "PF5 copies the data of the last transaction into the form.", "condition": "EIBAID = DFHPF5", "outcome": "PERFORM COPY-LAST-TRAN-DATA", "fields": ["EIBAID"], "citations": [{"program": "COTRN02C", "start_line": 146, "end_line": 147}]}
{"id": "COTRN02C-G4", "program": "COTRN02C", "paragraph": "PROCESS-ENTER-KEY", "kind": "validation", "summary": "The transaction is only added after the user confirms with Y; N or blank asks for confirmation, anything else is invalid.", "condition": "CONFIRMI = 'Y' or 'y'", "outcome": "ADD-TRANSACTION; otherwise 'Confirm to add this transaction...' or 'Invalid value. Valid values are (Y/N)...'", "fields": ["CONFIRMI"], "citations": [{"program": "COTRN02C", "start_line": 169, "end_line": 188}]}
{"id": "COTRN02C-G5", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-KEY-FIELDS", "kind": "validation", "summary": "An account ID, when entered, must be numeric; the card number is then looked up from the account.", "condition": "ACTIDINI entered and not numeric", "outcome": "'Account ID must be Numeric...'; else READ-CXACAIX-FILE fills CARDNINI", "fields": ["ACTIDINI", "XREF-CARD-NUM"], "citations": [{"program": "COTRN02C", "start_line": 196, "end_line": 209}]}
{"id": "COTRN02C-G6", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-KEY-FIELDS", "kind": "validation", "summary": "A card number, when entered instead, must be numeric; the account is then looked up from the card.", "condition": "CARDNINI entered and not numeric", "outcome": "'Card Number must be Numeric...'; else READ-CCXREF-FILE fills ACTIDINI", "fields": ["CARDNINI", "XREF-ACCT-ID"], "citations": [{"program": "COTRN02C", "start_line": 210, "end_line": 223}]}
{"id": "COTRN02C-G7", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-KEY-FIELDS", "kind": "validation", "summary": "Either an account ID or a card number must be entered.", "condition": "both ACTIDINI and CARDNINI empty", "outcome": "'Account or Card Number must be entered...'", "fields": ["ACTIDINI"], "citations": [{"program": "COTRN02C", "start_line": 224, "end_line": 229}]}
{"id": "COTRN02C-G8", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-DATA-FIELDS", "kind": "validation", "summary": "All transaction fields are mandatory: type, category, source, description, amount, both dates and the merchant ID, name, city and zip.", "condition": "any of TTYPCDI, TCATCDI, TRNSRCI, TDESCI, TRNAMTI, TORIGDTI, TPROCDTI, MIDI, MNAMEI, MCITYI, MZIPI is empty", "outcome": "'... can NOT be empty...' for the first empty field", "fields": ["TTYPCDI", "TRNAMTI", "MZIPI"], "citations": [{"program": "COTRN02C", "start_line": 251, "end_line": 293}, {"program": "COTRN02C", "start_line": 294, "end_line": 320}]}
{"id": "COTRN02C-G9", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-DATA-FIELDS", "kind": "validation", "summary": "Transaction type and category codes must be numeric.", "condition": "TTYPCDI or TCATCDI not numeric", "outcome": "'Type CD must be Numeric...' / 'Category CD must be Numeric...'", "fields": ["TTYPCDI", "TCATCDI"], "citations": [{"program": "COTRN02C", "start_line": 322, "end_line": 337}]}
{"id": "COTRN02C-G10", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-DATA-FIELDS", "kind": "validation", "summary": "The amount must be typed as a sign, 8 digits, a dot and 2 decimals.", "condition": "TRNAMTI does not match sign + 99999999.99", "outcome": "'Amount should be in format -99999999.99'", "fields": ["TRNAMTI"], "citations": [{"program": "COTRN02C", "start_line": 339, "end_line": 351}]}
{"id": "COTRN02C-G11", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-DATA-FIELDS", "kind": "validation", "summary": "The original date must be written as YYYY-MM-DD.", "condition": "TORIGDTI not in YYYY-MM-DD shape", "outcome": "'Orig Date should be in format YYYY-MM-DD'", "fields": ["TORIGDTI"], "citations": [{"program": "COTRN02C", "start_line": 353, "end_line": 366}]}
{"id": "COTRN02C-G12", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-DATA-FIELDS", "kind": "validation", "summary": "The processing date must be written as YYYY-MM-DD.", "condition": "TPROCDTI not in YYYY-MM-DD shape", "outcome": "'Proc Date should be in format YYYY-MM-DD'", "fields": ["TPROCDTI"], "citations": [{"program": "COTRN02C", "start_line": 368, "end_line": 381}]}
{"id": "COTRN02C-G13", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-DATA-FIELDS", "kind": "validation", "summary": "Both dates must be real calendar dates, checked by the date utility CSUTLDTC; message number 2513 from the utility is tolerated.", "condition": "CSUTLDTC-RESULT-SEV-CD is not '0000' and CSUTLDTC-RESULT-MSG-NUM is not '2513'", "outcome": "'Orig Date - Not a valid date...' / 'Proc Date - Not a valid date...'", "fields": ["CSUTLDTC-RESULT-SEV-CD", "CSUTLDTC-RESULT-MSG-NUM"], "citations": [{"program": "COTRN02C", "start_line": 389, "end_line": 407}, {"program": "COTRN02C", "start_line": 409, "end_line": 427}]}
{"id": "COTRN02C-G14", "program": "COTRN02C", "paragraph": "VALIDATE-INPUT-DATA-FIELDS", "kind": "validation", "summary": "Merchant ID must be numeric.", "condition": "MIDI not numeric", "outcome": "'Merchant ID must be Numeric...'", "fields": ["MIDI"], "citations": [{"program": "COTRN02C", "start_line": 430, "end_line": 436}]}
{"id": "COTRN02C-G15", "program": "COTRN02C", "paragraph": "ADD-TRANSACTION", "kind": "calculation", "summary": "A new transaction ID is the highest existing ID plus one.", "condition": "on confirmed add", "outcome": "read last TRAN-ID by browsing backwards from HIGH-VALUES, ADD 1 TO WS-TRAN-ID-N", "fields": ["TRAN-ID", "WS-TRAN-ID-N"], "citations": [{"program": "COTRN02C", "start_line": 444, "end_line": 451}]}
{"id": "COTRN02C-G16", "program": "COTRN02C", "paragraph": "READ-CXACAIX-FILE", "kind": "validation", "summary": "An account ID that is not in the cross-reference is rejected.", "condition": "READ of the account index returns NOTFND", "outcome": "'Account ID NOT found...'", "fields": ["WS-ERR-FLG"], "citations": [{"program": "COTRN02C", "start_line": 591, "end_line": 596}]}
{"id": "COTRN02C-G17", "program": "COTRN02C", "paragraph": "READ-CCXREF-FILE", "kind": "validation", "summary": "A card number that is not in the cross-reference is rejected.", "condition": "READ of the card xref returns NOTFND", "outcome": "'Card Number NOT found...'", "fields": ["WS-ERR-FLG"], "citations": [{"program": "COTRN02C", "start_line": 624, "end_line": 629}]}
{"id": "COTRN02C-G18", "program": "COTRN02C", "paragraph": "WRITE-TRANSACT-FILE", "kind": "error-handling", "summary": "If the new transaction ID already exists the add fails.", "condition": "WRITE returns DUPKEY or DUPREC", "outcome": "'Tran ID already exist...'", "fields": ["WS-ERR-FLG"], "citations": [{"program": "COTRN02C", "start_line": 735, "end_line": 741}]}
{"id": "CBACT04C-G1", "program": "CBACT04C", "paragraph": "MAIN", "kind": "routing", "summary": "Category balances are processed grouped by account; when the account changes, the previous account is updated and the new one loaded.", "condition": "TRANCAT-ACCT-ID differs from WS-LAST-ACCT-NUM", "outcome": "PERFORM 1050-UPDATE-ACCOUNT for the previous account, reset WS-TOTAL-INT", "fields": ["TRANCAT-ACCT-ID", "WS-LAST-ACCT-NUM", "WS-TOTAL-INT"], "citations": [{"program": "CBACT04C", "start_line": 194, "end_line": 205}]}
{"id": "CBACT04C-G2", "program": "CBACT04C", "paragraph": "MAIN", "kind": "data-access", "summary": "The interest rate is looked up by the account's group, the transaction category and the transaction type.", "condition": "for every category balance record", "outcome": "key = ACCT-GROUP-ID + TRANCAT-CD + TRANCAT-TYPE-CD in the disclosure group file", "fields": ["ACCT-GROUP-ID", "TRANCAT-CD", "TRANCAT-TYPE-CD"], "citations": [{"program": "CBACT04C", "start_line": 210, "end_line": 213}]}
{"id": "CBACT04C-G3", "program": "CBACT04C", "paragraph": "MAIN", "kind": "routing", "summary": "Interest is only computed for categories whose rate is not zero.", "condition": "DIS-INT-RATE NOT = 0", "outcome": "PERFORM 1300-COMPUTE-INTEREST", "fields": ["DIS-INT-RATE"], "citations": [{"program": "CBACT04C", "start_line": 214, "end_line": 217}]}
{"id": "CBACT04C-G4", "program": "CBACT04C", "paragraph": "1200-GET-INTEREST-RATE", "kind": "data-access", "summary": "If the account's group has no rate record, the DEFAULT group's rate is used.", "condition": "DISCGRP-STATUS = '23' (not found)", "outcome": "FD-DIS-ACCT-GROUP-ID = 'DEFAULT', PERFORM 1200-A-GET-DEFAULT-INT-RATE", "fields": ["DISCGRP-STATUS", "FD-DIS-ACCT-GROUP-ID"], "citations": [{"program": "CBACT04C", "start_line": 436, "end_line": 439}]}
{"id": "CBACT04C-G5", "program": "CBACT04C", "paragraph": "1300-COMPUTE-INTEREST", "kind": "calculation", "summary": "Monthly interest = category balance x annual rate (%) / 1200, summed per account.", "condition": "rate is not zero", "outcome": "WS-MONTHLY-INT = (TRAN-CAT-BAL * DIS-INT-RATE) / 1200, added to WS-TOTAL-INT", "fields": ["WS-MONTHLY-INT", "TRAN-CAT-BAL", "DIS-INT-RATE", "WS-TOTAL-INT"], "citations": [{"program": "CBACT04C", "start_line": 464, "end_line": 467}]}
{"id": "CBACT04C-G6", "program": "CBACT04C", "paragraph": "1300-B-WRITE-TX", "kind": "calculation", "summary": "Each interest charge gets a transaction ID made of the run date plus a running suffix.", "condition": "for every interest charge", "outcome": "TRAN-ID = PARM-DATE + WS-TRANID-SUFFIX", "fields": ["PARM-DATE", "WS-TRANID-SUFFIX", "TRAN-ID"], "citations": [{"program": "CBACT04C", "start_line": 474, "end_line": 480}]}
{"id": "CBACT04C-G7", "program": "CBACT04C", "paragraph": "1300-B-WRITE-TX", "kind": "other", "summary": "Interest is posted as a system transaction of type 01, category 05, described as 'Int. for a/c' plus the account ID.", "condition": "for every interest charge", "outcome": "TRAN-TYPE-CD '01', TRAN-CAT-CD '05', TRAN-SOURCE 'System', TRAN-AMT = WS-MONTHLY-INT", "fields": ["TRAN-TYPE-CD", "TRAN-CAT-CD", "WS-MONTHLY-INT"], "citations": [{"program": "CBACT04C", "start_line": 482, "end_line": 490}]}
{"id": "CBACT04C-G8", "program": "CBACT04C", "paragraph": "1050-UPDATE-ACCOUNT", "kind": "calculation", "summary": "At account update the total interest is added to the current balance and the cycle credit and debit are reset to zero.", "condition": "when the account's records are finished", "outcome": "ACCT-CURR-BAL += WS-TOTAL-INT; ACCT-CURR-CYC-CREDIT = 0; ACCT-CURR-CYC-DEBIT = 0", "fields": ["ACCT-CURR-BAL", "WS-TOTAL-INT", "ACCT-CURR-CYC-CREDIT"], "citations": [{"program": "CBACT04C", "start_line": 352, "end_line": 356}]}
{"id": "COBIL00C-G1", "program": "COBIL00C", "paragraph": "MAIN-PARA", "kind": "routing", "summary": "Without a session (no COMMAREA) the user is sent back to sign-on.", "condition": "EIBCALEN = 0", "outcome": "CDEMO-TO-PROGRAM = 'COSGN00C'", "fields": ["EIBCALEN", "CDEMO-TO-PROGRAM"], "citations": [{"program": "COBIL00C", "start_line": 107, "end_line": 108}]}
{"id": "COBIL00C-G2", "program": "COBIL00C", "paragraph": "PROCESS-ENTER-KEY", "kind": "validation", "summary": "Account ID is required.", "condition": "ACTIDINI is spaces or low-values", "outcome": "'Acct ID can NOT be empty...'", "fields": ["ACTIDINI"], "citations": [{"program": "COBIL00C", "start_line": 159, "end_line": 164}]}
{"id": "COBIL00C-G3", "program": "COBIL00C", "paragraph": "PROCESS-ENTER-KEY", "kind": "validation", "summary": "Payment needs confirmation: Y pays, N clears the screen, blank only shows the balance, anything else is invalid.", "condition": "CONFIRMI value", "outcome": "Y/y: CONF-PAY-YES; N/n: CLEAR-CURRENT-SCREEN; other: 'Invalid value. Valid values are (Y/N)...'", "fields": ["CONFIRMI", "CONF-PAY-YES"], "citations": [{"program": "COBIL00C", "start_line": 173, "end_line": 190}]}
{"id": "COBIL00C-G4", "program": "COBIL00C", "paragraph": "PROCESS-ENTER-KEY", "kind": "validation", "summary": "An account with a zero or negative balance cannot be paid.", "condition": "ACCT-CURR-BAL <= ZEROS", "outcome": "'You have nothing to pay...'", "fields": ["ACCT-CURR-BAL"], "citations": [{"program": "COBIL00C", "start_line": 198, "end_line": 205}]}
{"id": "COBIL00C-G5", "program": "COBIL00C", "paragraph": "PROCESS-ENTER-KEY", "kind": "calculation", "summary": "A bill payment always pays the full current balance and is recorded as a type 02, category 2 online payment.", "condition": "confirmed payment", "outcome": "TRAN-AMT = ACCT-CURR-BAL; TRAN-TYPE-CD '02'; TRAN-DESC 'BILL PAYMENT - ONLINE'", "fields": ["TRAN-AMT", "ACCT-CURR-BAL", "TRAN-TYPE-CD"], "citations": [{"program": "COBIL00C", "start_line": 220, "end_line": 229}]}
{"id": "COBIL00C-G6", "program": "COBIL00C", "paragraph": "PROCESS-ENTER-KEY", "kind": "calculation", "summary": "After the payment is written, the paid amount is subtracted from the account balance.", "condition": "confirmed payment written", "outcome": "ACCT-CURR-BAL = ACCT-CURR-BAL - TRAN-AMT, then UPDATE-ACCTDAT-FILE", "fields": ["ACCT-CURR-BAL", "TRAN-AMT"], "citations": [{"program": "COBIL00C", "start_line": 233, "end_line": 235}]}
{"id": "COBIL00C-G7", "program": "COBIL00C", "paragraph": "PROCESS-ENTER-KEY", "kind": "calculation", "summary": "The payment's transaction ID is the highest existing ID plus one.", "condition": "confirmed payment", "outcome": "ADD 1 TO WS-TRAN-ID-NUM", "fields": ["WS-TRAN-ID-NUM", "TRAN-ID"], "citations": [{"program": "COBIL00C", "start_line": 212, "end_line": 219}]}
{"id": "COBIL00C-G8", "program": "COBIL00C", "paragraph": "READ-ACCTDAT-FILE", "kind": "validation", "summary": "An unknown account ID is rejected.", "condition": "READ of the account file returns NOTFND", "outcome": "'Account ID NOT found...'", "fields": ["WS-ERR-FLG"], "citations": [{"program": "COBIL00C", "start_line": 359, "end_line": 362}]}
