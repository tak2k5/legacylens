# Mô hình LLM, gọi qua API kiểu OpenAI. Chọn MỘT khối, bỏ dấu # ở đầu các dòng của khối đó.
# Trong Codespaces có thể bỏ qua file này và đặt các biến dưới đây làm Codespaces secrets.

# A. Khuyên dùng: mô hình open-weight Qwen2.5 chạy bằng Ollama trên Colab T4.
#    Mở notebooks/colab_llm.ipynb trên Colab, Run all, ô cuối in ra đúng 4 dòng này với URL thật.
# LLM_BASE_URL=https://xxxx-xxxx.trycloudflare.com/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama
# LLM_CONTEXT=32768

# B. Dự phòng, không phải open-weight: Gemini gói miễn phí (khóa ở aistudio.google.com/apikey).
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# C. Dự phòng: Groq gói miễn phí (cùng khóa với repo vn-legal-assistant). Groq phục vụ cả mô hình open-weight
#    như llama-3.3-70b-versatile, nhưng giới hạn token mỗi phút thấp.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# Tùy chọn: nghỉ giữa hai lần gọi (giây) khi gặp lỗi 429, số lần thử lại
# LLM_PAUSE=4
# LLM_MAX_RETRIES=6
