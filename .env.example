# Mô hình LLM, dùng bất kỳ API nào tương thích OpenAI. Chọn MỘT khối, bỏ dấu # ở khối đó.
# Trong Codespaces có thể bỏ qua file này và đặt các biến dưới đây làm Codespaces secrets.

# A. Gemini (miễn phí, khóa lấy ở aistudio.google.com). Tên mô hình xem ở trang Rate limits của AI Studio.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# B. Groq (miễn phí, cùng khóa với repo vn-legal-assistant). Gói miễn phí giới hạn token mỗi phút thấp.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# C. Ollama trên Colab T4 (notebooks/colab_llm.ipynb in ra URL). Không cần khóa.
# LLM_BASE_URL=https://xxxx.trycloudflare.com/v1
# LLM_MODEL=qwen2.5:7b-instruct

# Tùy chọn: nghỉ giữa hai lần gọi (giây) khi gặp lỗi 429, số lần thử lại
# LLM_PAUSE=4
# LLM_MAX_RETRIES=6
